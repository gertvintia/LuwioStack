{
  "name": "@luwio/google",
  "version": "0.0.0",
  "description": "Google web-platform integrations for React, one namespace per library.",
  "keywords": [
    "google",
    "google-maps",
    "react",
    "script-loader",
    "luwio"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./map": {
      "import": {
        "types": "./dist/map/index.d.mts",
        "default": "./dist/map/index.mjs"
      },
      "require": {
        "types": "./dist/map/index.d.cts",
        "default": "./dist/map/index.cjs"
      }
    },
    "./analytics": {
      "import": {
        "types": "./dist/analytics/index.d.mts",
        "default": "./dist/analytics/index.mjs"
      },
      "require": {
        "types": "./dist/analytics/index.d.cts",
        "default": "./dist/analytics/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "catalog:",
    "happy-dom": "^20.11.2",
    "react": "catalog:",
    "react-dom": "catalog:"
  }
}
