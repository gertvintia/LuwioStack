{
  "name": "@luwio/phone",
  "version": "0.0.0",
  "description": "Typed phone-number parsing, validation and formatting for React \u2014 powered by google-libphonenumber, with a `<Phone>` provider and `usePhone` hook.",
  "keywords": [
    "phone",
    "phone-number",
    "e164",
    "libphonenumber",
    "validation",
    "i18n",
    "react",
    "hooks",
    "luwio"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.mts",
        "default": "./dist/react.mjs"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --no-clean",
    "test": "vitest run",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@luwio/country": "workspace:*",
    "google-libphonenumber": "^3.2.40"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/google-libphonenumber": "^7.4.30",
    "@types/react": "catalog:",
    "happy-dom": "^20.11.2",
    "react": "catalog:",
    "react-dom": "catalog:"
  }
}
